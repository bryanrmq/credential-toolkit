{
  "name": "@bryanrmq/oca-generator",
  "version": "0.1.0",
  "description": "Build and check swiyu OCA bundles for SD-JWT credentials: project files, validation, bundle, #integrity and VCT snippet.",
  "license": "MIT",
  "author": "Bryan Reymonenq",
  "homepage": "https://github.com/bryanrmq/oca-generator/tree/main/packages/oca-generator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryanrmq/oca-generator.git",
    "directory": "packages/oca-generator"
  },
  "bugs": "https://github.com/bryanrmq/oca-generator/issues",
  "keywords": ["oca", "overlays-capture-architecture", "swiyu", "sd-jwt", "verifiable-credentials"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "canonicalize": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
