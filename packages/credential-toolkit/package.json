{
  "name": "@bryanrmq/credential-toolkit",
  "version": "0.1.0",
  "description": "Build and check swiyu OCA bundles for SD-JWT credentials: project files, validation, bundle, #integrity and VCT snippet, as a library and the credential-toolkit (ctk) command.",
  "license": "MIT",
  "author": "Bryan Reymonenq",
  "homepage": "https://github.com/bryanrmq/credential-toolkit/tree/main/packages/credential-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryanrmq/credential-toolkit.git",
    "directory": "packages/credential-toolkit"
  },
  "bugs": "https://github.com/bryanrmq/credential-toolkit/issues",
  "keywords": ["oca", "overlays-capture-architecture", "swiyu", "sd-jwt", "verifiable-credentials"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "credential-toolkit": "./dist/cli.js",
    "ctk": "./dist/cli.js"
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cli.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "canonicalize": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
